      "request": {
        "description": "Measure the loaded two-joint MuJoCo model's numerical actuation authority, inertia, saturation response, and post-pulse settling before choosing between a dynamics/stabilization direction and a learning/exposure direction.",
        "measurements": [
          {
            "args": [
