# Python bytecode and packaging output
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Training results (timestamped runs, never silently overwritten)
models/

# Validated curriculum checkpoints live under research/checkpoints and are
# intentionally versioned. Only disposable training candidates stay in models/.
research/checkpoints/challengers/

# Test, lint, type-check, and coverage output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest-run-*/
.pytest-*-temp/

# Transient research runner controls and generated summaries
research/last_train.log
research/last_train_summary.md
research/last_evaluation.json
research/GOAL_REACHED
research/RECOVERY_PENDING
research/RESTART_PENDING
research/brief.md
research/proposal.json
research/evaluation_request.json
