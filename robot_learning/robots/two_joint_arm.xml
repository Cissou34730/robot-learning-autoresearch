<mujoco model="two_joint_arm">
  <option gravity="0 0 0" timestep="0.002"/>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1"/>
    <geom type="plane" size="0.35 0.35 0.05" rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>
    <camera name="overhead" pos="0 0 0.55" xyaxes="1 0 0 0 1 0"/>

    <body name="base" pos="0 0 0">
      <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>
      <body name="upper_arm" pos="0 0 0.02">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-170 170"
               damping="0.5" armature="0.01"/>
        <geom type="capsule" fromto="0 0 0 0.12 0 0" size="0.015" rgba="0.7 0.35 0.35 1"/>
        <body name="forearm" pos="0.12 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-170 170"
                 damping="0.5" armature="0.01"/>
          <geom type="capsule" fromto="0 0 0 0.10 0 0" size="0.012" rgba="0.35 0.35 0.7 1"/>
          <site name="end_effector" pos="0.10 0 0" size="0.008" rgba="0.95 0.9 0.2 1"/>
        </body>
      </body>
    </body>

    <body name="target" mocap="true" pos="0.15 0 0">
      <geom type="sphere" size="0.012" rgba="0.15 0.8 0.25 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor joint="shoulder" ctrlrange="-1 1" gear="5"/>
    <motor joint="elbow" ctrlrange="-1 1" gear="5"/>
  </actuator>
</mujoco>
