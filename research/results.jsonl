nt": "155a36259dbff79e9a0a05bacfd23bf4d344968382030c5db0e199d8547ab273", "official_benchmark": false, "schema_version": 5, "seed": 20260918, "success_percent": 94.5}, "model_fingerprint": "155a36259dbff79e9a0a05bacfd23bf4d344968382030c5db0e199d8547ab273", "omitted_alternative": "checkpoint-95232", "seed": 20260918, "selection": "The final saved checkpoint carries a lower training-window proxy (0.95) than checkpoint-100352 (0.97), and the training-window proxy declined after 100k (0.93-0.95 through 120832), so the training-time ordering of the two leading checkpoints is ambiguous and the proxy conflates the 14-20 cm range. Measuring it on the same 200 official-distribution episodes (same seed) as checkpoint-100352 supplies a paired, reduced-variance comparison of the two leading checkpoints on the actual task. This decides which checkpoint is designated as the working lineage and therefore which weights a continuation would extend."}], "schema_version": 1, "scientific_commit": "c34953ba8f9781b04f72b683f4e23b7f43c427c4", "status": "closed", "task_reference_evaluations": [{"candidate": "checkpoint-100352", "episodes": 200, "evaluation_artifact": "research/evaluations/603a61bf-d5d0-437a-9aea-3d5988940d85/task-reference-603a61bf-d5d0-437a-9aea-3d5988940d85-experiment-1-checkpoint-100352-task-reference-v1.json", "evaluation_artifact_fingerprint": "7e5247c5156987c3722947f224a58f6138ffeb73cea984ae3a65e2b3d8fb205f", "instrument": "task_reference", "label": "baseline peak on protected task-reference panel", "model_fingerprint": "eb40609107fbf9aa18758f1aff66d99c808bbddcf2dccb484ac57b92fd1cb17b", "omitted_alternative": "checkpoint-95232", "panel": "task-reference-v1", "panel_version": 1, "seed": 7300, "selection": "The protected task-reference panel is the closest available development analogue of the official verdict and is independent of researcher-owned environment, observation and evaluation code, whereas the research-evaluation panel above runs through make_evaluation_env.