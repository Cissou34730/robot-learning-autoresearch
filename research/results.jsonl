{"campaign_id": "77a975a5-9917-4178-ad06-ede00161560f", "completed_at": "2026-10-01T05:31:55Z", "error": null, "id": "M1", "inquiry_id": null, "kind": "measurement", "request": {"description": "Characterize bounded-effort reach, braking, settling, and complete-hold feasibility across the full official target geometry before choosing a learning intervention.", "measurements": [{"args": ["--output", "research/evaluations/77a975a5-9917-4178-ad06-ede00161560f/initial_dynamics_probe.json"], "artifact": "research/evaluations/77a975a5-9917-4178-ad06-ede00161560f/initial_dynamics_probe.json", "instrument": "python_module", "label": "full-distribution bounded-PD dynamics probe", "module": "research.lab.dynamics_probe"}], "rationale": "The scientific model establishes kinematic reach but leaves effective acceleration, braking margin, branch asymmetry, and hold stability unknown. A deterministic bounded joint-space PD probe over all official radii and angles, both feasible IK branches, and three damping schedules discriminates whether the first bottleneck is physical settling authority or policy learning and radial coverage."}, "result": {"measurements": [{"args": ["--output", "research/evaluations/77a975a5-9917-4178-ad06-ede00161560f/initial_dynamics_probe.json"], "instrument": "python_module", "label": "full-distribution bounded-PD dynamics probe", "metrics": {"evaluation_artifact": "research/evaluations/77a975a5-9917-4178-ad06-ede00161560f/python-module-M1-1-initial_dynamics_probe.json", "evaluation_artifact_fingerprint": "5379f8937096299f3ccd2023675d4a2299900edef75f0ce22eebd0074259fa3a"}, "module": "research.lab.dynamics_probe"}], "paired_comparisons": [], "status": "completed", "tool_provenance": {"campaign_lab_manifest": [{"fingerprint": "0fea555cc7975058791a0fd738504e6542c31e6381a1b1df129ad89acb04b0f7", "path": "research/lab/dynamics_probe.py"}], "campaign_lab_publication": {"commit": "dfd23ce8ffafe8dac7eb54654eeee58054b51fd6", "fingerprint": "98dd69541832fe66cd37d2162c